# Copy to .env and change the values: cp .env.example .env
# .env is gitignored, so real passwords never reach GitHub (like AWS Secrets Manager).

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=inventory
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app

# Host ports
API_PORT=8000
PHPMYADMIN_PORT=8081
